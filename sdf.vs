mut d := 0

fn hello() {
    mut i := 0

    while i < 100 {
        i = i + 1
    }
}

loop {
    d = d + 1
    if d == 10 {
        break
    } else {
        mut a := 0

        while a <= 15 {
            a = a + 1
        }
    }
}


